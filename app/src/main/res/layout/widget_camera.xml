<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_camera_name"
        android:scaleType="fitCenter" />

    <ImageView
        android:id="@+id/widget_shutter"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:contentDescription="@string/widget_camera_photo"
        android:src="@drawable/widget_shutter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_photo"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/widget_camera_photo"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <View
            android:layout_width="6dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/widget_video"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/widget_camera_video"
            android:textColor="#FFDA291C"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
